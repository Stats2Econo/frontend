# Copy this file to .env.local and fill in the values.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Secret key: server only. NEVER prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Razorpay → Account & Settings → API Keys (use rzp_test_ keys while testing)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Razorpay → Account & Settings → Webhooks → the secret you type when creating the webhook
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string
