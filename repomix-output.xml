<file path="app/actions/auth.ts">
"use server";

import { headers } from "next/headers";
import { redirect } from "next/navigation";
import { createClient } from "@/lib/supabase/server";
import { isSupabaseConfigured } from "@/lib/supabase/env";
import { safeNext } from "@/lib/auth";
import type { FormState } from "@/lib/types";

const text = (formData: FormData, key: string, max = 320) =>
  String(formData.get(key) ?? "").trim().slice(0, max);

const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const MIN_PASSWORD_LENGTH = 8;

/** Send people to onboarding until their profile is complete, like the Google callback does. */
function afterSignIn(profileCompleted: boolean | null | undefined, next: string) {
  return profileCompleted ? next : `/onboarding?next=${encodeURIComponent(next)}`;
}

export async function signInWithPassword(_prev: FormState | undefined, formData: FormData): Promise<FormState> {
  const email = text(formData, "email");
  const password = String(formData.get("password") ?? "");
  const next = safeNext(text(formData, "next"));

  if (!EMAIL_PATTERN.test(email)) return { error: "Please enter a valid email address." };
  if (!password) return { error: "Please enter your password." };
  if (!isSupabaseConfigured) return { error: "Sign-in is not available right now." };

  const supabase = await createClient();
  const { data, error } = await supabase.auth.signInWithPassword({ email, password });

  if (error || !data.user) {
    if (error?.code === "email_not_confirmed") {
      return { error: "Please confirm your email address first. Check your inbox for the link." };
    }
    return { error: "Incorrect email or password." };
  }

  const { data: profile } = await supabase
    .from("profiles")
    .select("profile_completed")
    .eq("id", data.user.id)
    .maybeSingle();

  redirect(afterSignIn(profile?.profile_completed, next));
}

export async function signUpWithPassword(_prev: FormState | undefined, formData: FormData): Promise<FormState> {
  const fullName = text(formData, "full_name", 200);
  const email = text(formData, "email");
  const password = String(formData.get("password") ?? "");
  const confirm = String(formData.get("confirm_password") ?? "");
  const next = safeNext(text(formData, "next"));

  if (!fullName) return { error: "Please enter your full name." };
  if (!EMAIL_PATTERN.test(email)) return { error: "Please enter a valid email address." };
  if (password.length < MIN_PASSWORD_LENGTH) {
    return { error: `Your password must be at least ${MIN_PASSWORD_LENGTH} characters.` };
  }
  if (password !== confirm) return { error: "The two passwords do not match." };
  if (!isSupabaseConfigured) return { error: "Registration is not available right now." };

  const origin = (await headers()).get("origin");
  const supabase = await createClient();
  const { data, error } = await supabase.auth.signUp({
    email,
    password,
    options: {
      data: { full_name: fullName },
      // Where the confirmation link lands (only used when email confirmation is enabled).
      emailRedirectTo: origin ? `${origin}/auth/callback?next=${encodeURIComponent(next)}` : undefined,
    },
  });

  if (error) {
    if (error.code === "weak_password") {
      return { error: "That password is too weak. Try a longer one with a mix of characters." };
    }
    return { error: "Could not create your account. Please try again." };
  }

  // With email confirmation on, an already-registered address comes back with no identities
  // (to avoid leaking which emails exist) and no session.
  if (data.user && data.user.identities?.length === 0) {
    return { error: "An account with this email already exists. Please sign in instead." };
  }

  if (!data.session) {
    return { ok: true, message: "Almost there! We've sent a confirmation link to your email. Open it to finish creating your account." };
  }

  redirect(afterSignIn(false, next));
}
</file>

<file path="app/actions/contact.ts">
"use server";

import { createClient } from "@/lib/supabase/server";
import { isSupabaseConfigured } from "@/lib/supabase/env";
import type { FormState } from "@/lib/types";

export async function sendContactMessage(_prev: FormState | undefined, formData: FormData): Promise<FormState> {
  const get = (key: string, max: number) => String(formData.get(key) ?? "").trim().slice(0, max);

  // Hidden honeypot field: real visitors leave it empty.
  if (get("company", 200)) return { ok: true };

  const message = {
    first_name: get("firstName", 100),
    last_name: get("lastName", 100),
    email: get("email", 320),
    subject: get("subject", 300),
    message: get("message", 5000),
  };

  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(message.email)) {
    return { error: "Please enter a valid email address." };
  }
  if (!isSupabaseConfigured) return { error: "The contact form is not available right now." };

  const supabase = await createClient();
  const { error } = await supabase.from("contact_messages").insert(message);
  if (error) return { error: "Could not send your message. Please email us instead." };

  return { ok: true };
}
</file>

<file path="app/actions/profile.ts">
"use server";

import { redirect } from "next/navigation";
import { revalidatePath } from "next/cache";
import { createClient } from "@/lib/supabase/server";
import { getUser, safeNext } from "@/lib/auth";
import type { FormState } from "@/lib/types";

const text = (formData: FormData, key: string) => String(formData.get(key) ?? "").trim();
const optional = (formData: FormData, key: string) => text(formData, key) || null;

export async function saveProfile(_prev: FormState | undefined, formData: FormData): Promise<FormState> {
  const user = await getUser();
  if (!user) return { error: "Your session has expired. Please sign in again." };

  const profile = {
    full_name: text(formData, "full_name"),
    phone: text(formData, "phone"),
    whatsapp: optional(formData, "whatsapp"),
    date_of_birth: optional(formData, "date_of_birth"),
    gender: optional(formData, "gender"),
    occupation: text(formData, "occupation"),
    institution: text(formData, "institution"),
    designation: optional(formData, "designation"),
    highest_qualification: optional(formData, "highest_qualification"),
    address_line1: text(formData, "address_line1"),
    address_line2: optional(formData, "address_line2"),
    city: text(formData, "city"),
    state: text(formData, "state"),
    country: text(formData, "country"),
    pincode: text(formData, "pincode"),
  };

  const required: [keyof typeof profile, string][] = [
    ["full_name", "Full name"],
    ["phone", "Phone number"],
    ["occupation", "Occupation"],
    ["institution", "Institution / organisation"],
    ["address_line1", "Address"],
    ["city", "City"],
    ["state", "State"],
    ["country", "Country"],
    ["pincode", "PIN / postal code"],
  ];
  const missing = required.filter(([key]) => !profile[key]).map(([, label]) => label);
  if (missing.length) return { error: `Please fill in: ${missing.join(", ")}.` };

  const phonePattern = /^\+?[0-9][0-9\s-]{8,16}$/;
  if (!phonePattern.test(profile.phone)) return { error: "Please enter a valid phone number." };
  if (profile.whatsapp && !phonePattern.test(profile.whatsapp)) {
    return { error: "Please enter a valid WhatsApp number." };
  }
  if (!/^[A-Za-z0-9\s-]{3,10}$/.test(profile.pincode)) {
    return { error: "Please enter a valid PIN / postal code." };
  }

  const supabase = await createClient();
  const { error } = await supabase
    .from("profiles")
    .update({ ...profile, profile_completed: true })
    .eq("id", user.id);

  if (error) return { error: "Could not save your profile. Please try again." };

  revalidatePath("/", "layout");

  if (formData.get("mode") === "onboarding") {
    redirect(safeNext(text(formData, "next")));
  }
  return { ok: true, message: "Profile updated." };
}
</file>

