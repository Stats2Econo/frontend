          </ul>
        </section>

        <section>
          <h2 className="mb-3 text-sm font-semibold text-ink">{editing ? "Edit announcement" : "New announcement"}</h2>
          <AnnouncementForm key={editing?.id ?? "new"} courses={courses} announcement={editing} />
        </section>
      </div>
    </div>
  );
}
